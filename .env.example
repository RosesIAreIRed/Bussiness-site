# ============================================================
# Ormilo Growth OS — environment configuration (ТЗ §24)
# Скопіюйте у .env та за потреби змініть значення.
# Значення за замовчуванням відповідають docker-compose.yml.
# При APP_ENV=production критичні змінні обовʼязково задаються явно
# (packages/config відхиляє production-запуск на дефолтах).
# ============================================================

NODE_ENV=development
# Середовище деплою (development | test | staging | production).
# Саме APP_ENV вмикає production-обмеження (NODE_ENV=production ставить сам Next.js
# у `next build`/`next start`, тому guard-и на нього не вішаються).
APP_ENV=development
LOG_LEVEL=debug

APP_URL=http://localhost:3000

# --- Ports ---
WEB_PORT=3000
WORKER_HEALTH_PORT=3001
RENDER_WORKER_HEALTH_PORT=3002

# --- PostgreSQL ---
DATABASE_URL=postgresql://ormilo:ormilo@localhost:5432/ormilo

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible storage (MinIO у local development) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ormilo-assets
S3_ACCESS_KEY=ormilo
S3_SECRET_KEY=ormilo-dev-secret

# --- Shopify (single store; підключення — Milestone 4) ---
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Версія GraphQL Admin API тримається в конфігурації (не в коді).
SHOPIFY_API_VERSION=2026-07

# --- AI providers (обираються окремо для text/image/video/TTS; mock у dev) ---
TEXT_AI_PROVIDER=
TEXT_AI_API_KEY=
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=
VIDEO_AI_PROVIDER=
VIDEO_AI_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# --- Meta Marketing API (optional milestone) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Security / observability ---
# 64 hex-символи (32 байти): згенеруйте через `openssl rand -hex 32`.
# Для local development діє публічний dev-дефолт із packages/config;
# при APP_ENV=production значення ОБОВʼЯЗКОВО задається явно.
ENCRYPTION_KEY=
WEBHOOK_SECRET=
SENTRY_DSN=

# --- Cost guardrails (ТЗ §18) ---
AI_DAILY_BUDGET_USD=10
AI_CREATIVE_BATCH_BUDGET_USD=3
