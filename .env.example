# ============================================================
# Ormilo Growth OS — environment configuration (приклад)
# Скопіюйте у .env та за потреби змініть значення.
# Значення за замовчуванням відповідають infra/docker-compose.yml.
# У production ВСІ значення нижче обовʼязково задаються явно
# (packages/config відхиляє production-запуск на дефолтах).
# ============================================================

NODE_ENV=development
# Середовище деплою (development | test | staging | production).
# Саме APP_ENV вмикає production-обмеження (NODE_ENV=production ставить сам Next.js
# у `next build`/`next start`, тому guard-и на нього не вішаються).
APP_ENV=development
LOG_LEVEL=debug

# --- Ports ---
WEB_PORT=3000
WORKER_HEALTH_PORT=3001
RENDER_WORKER_HEALTH_PORT=3002

# --- PostgreSQL ---
DATABASE_URL=postgresql://ormilo:ormilo@localhost:5432/ormilo

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible storage (MinIO у local development) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ormilo
S3_SECRET_ACCESS_KEY=ormilo-dev-secret
S3_BUCKET_ASSETS=ormilo-assets

# --- Shopify ---
# Версія GraphQL Admin API тримається в конфігурації (не в коді).
SHOPIFY_API_VERSION=2026-07

# ============================================================
# Заповнюються у пізніших milestones (для Milestone 0 не потрібні):
# ============================================================
# SHOPIFY_APP_API_KEY=
# SHOPIFY_APP_API_SECRET=
# SHOPIFY_WEBHOOK_SECRET=
# APP_ENCRYPTION_KEY=            # AES-ключ для шифрування integration tokens (M1)
# ANTHROPIC_API_KEY=             # реальний TextGenerationProvider (M2+)
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=            # TTS provider (M3+)
# META_ACCESS_TOKEN=             # Meta Marketing API (optional milestone)
# META_AD_ACCOUNT_ID=
